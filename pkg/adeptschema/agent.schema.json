{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itaywol.github.io/adeptability/schemas/agent.schema.json",
  "title": "Adeptability Agent",
  "type": "object",
  "required": ["id", "description"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "mode": {
      "type": "string",
      "enum": ["subagent", "primary", "all"],
      "default": "subagent"
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "disallowed-tools": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "harness": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_][a-z0-9_-]{0,49}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "not": {
          "anyOf": [
            { "required": ["id"] },
            { "required": ["name"] },
            { "required": ["description"] }
          ]
        }
      }
    }
  }
}
