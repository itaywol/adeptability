---
// adeptability landing page. Ported ~1:1 from the design reference.
// Self-hosted fonts (zero external requests) + scoped styles imported below.
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/landing.css';

const title = 'adeptability: write an AI skill once, run it in every coding agent';
const description =
  'adept lets you author an AI coding skill or subagent once, then render it accurately into Claude Code, Cursor, Copilot, Codex, OpenCode and 50+ more agents. Dotfiles for your AI coding agents.';
const ogDescription =
  'One source of truth. The right on-disk format everywhere. Author a skill or subagent once and adept renders it into every coding agent.';
const canonical = 'https://adeptability.itaywol.tools/';
const socialCard = `${canonical}social-card.png`;

// Structured data for search engines and AI answer engines. Everything here is
// factual: nothing invented. price 0 + MIT license reflect the open-source project.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'adeptability',
  alternateName: 'adept',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description:
    'Open-source Go CLI that lets you author an AI coding skill or subagent once, then render it accurately into Claude Code, Cursor, GitHub Copilot, OpenAI Codex, OpenCode, and 50+ other AI coding agents.',
  url: canonical,
  downloadUrl: 'https://github.com/itaywol/adeptability/releases',
  softwareHelp: 'https://adeptability.itaywol.tools/docs/',
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  programmingLanguage: 'Go',
  codeRepository: 'https://github.com/itaywol/adeptability',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  sameAs: ['https://github.com/itaywol/adeptability'],
  author: {
    '@type': 'Person',
    name: 'Itay Wolfish',
    url: 'https://itaywol.com',
    sameAs: [
      'https://itaywol.com',
      'https://www.linkedin.com/in/itaywolfish/',
      'https://github.com/itaywol',
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="adeptability" />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:alt" content="adeptability: write an AI skill once, run it in every coding agent" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={socialCard} />

    <!-- Structured data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- PostHog analytics (bundled from npm; key injected at build time) -->
    <script>
      import '../scripts/analytics';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

